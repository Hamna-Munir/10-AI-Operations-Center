# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file.

# --- App ---
APP_ENV=development
APP_NAME=AI Operations Center
DATABASE_PATH=database/operations.db

# --- LLM provider (used from Day 66) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_model_name_here

# --- Integration modes ---
# mock = sample data / simulated action (clearly labelled in the UI)
# live = real external service (requires credentials below)
EMAIL_MODE=mock
CALENDAR_MODE=mock
CRM_MODE=mock

# --- Email (only needed if EMAIL_MODE=live) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Calendar (only needed if CALENDAR_MODE=live) ---
CALENDAR_CREDENTIALS_PATH=
